# Скопируйте в .env (или задайте в CI). Секреты сюда НЕ коммитятся: .env в .gitignore.
# Локальный стек (`npm run local:start`) сам пишет .env.local с локальными значениями —
# этот файл нужен для удалённого проекта Supabase и публикации.

# ---------------------------------------------------------------- фронтенд (Vite, публичные значения)
# URL проекта и publishable/anon-ключ — они и так видны в браузере.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Публичная половина VAPID (приватная — только в секретах Edge Functions).
VITE_VAPID_PUBLIC_KEY=<vapid-public-key-base64url>

# ---------------------------------------------------------------- скрипты конвейера (tenant:*, owner:invite)
# Только на машине администратора / в CI. Service role обходит RLS — никогда во фронтенд.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Адрес опубликованного сайта (для tenant:verify и ссылок в уведомлениях)
PUBLIC_APP_URL=https://<your-pages-domain>

# ---------------------------------------------------------------- Cloudflare Pages (tenant:publish --deploy)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=

# ---------------------------------------------------------------- секреты Edge Functions
# Задаются командой `supabase secrets set --env-file supabase/functions/.env` (см. SETUP.md).
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY Supabase передаёт функциям сам.
# LLM_BASE_URL=https://<openai-compatible-endpoint>/v1
# LLM_API_KEY=<secret>
# LLM_MODEL=<model-id>
# LLM_TOOL_MODE=auto            # auto | tools | json
# LLM_TENANT_DAILY_TOKENS=200000
# LLM_GLOBAL_DAILY_TOKENS=2000000
# LLM_TIMEOUT_MS=20000
# VAPID_PUBLIC_KEY=<base64url uncompressed P-256 point>
# VAPID_PRIVATE_KEY=<base64url d>
# VAPID_SUBJECT=mailto:admin@example.com
# CRON_SECRET=<random 32+ chars, same value as vault secret cron_secret>
# IP_HASH_SALT=<random string>
# IP_HEADER=x-forwarded-for
# ALLOWED_ORIGINS=https://<your-pages-domain>
# PUBLIC_APP_URL=https://<your-pages-domain>
