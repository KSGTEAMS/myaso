{
  "name": "pickup-orders",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/build-shells.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "local:install": "bash scripts/local/install.sh",
    "local:db": "tsx scripts/local/db.ts",
    "local:start": "tsx scripts/local/stack.ts start",
    "local:stop": "tsx scripts/local/stack.ts stop",
    "local:status": "tsx scripts/local/stack.ts status",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:functions": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts scripts/local/functions-server.ts",
    "test:e2e": "playwright test",
    "tenant:new": "tsx scripts/tenant-new.ts",
    "tenant:validate": "tsx scripts/tenant-validate.ts",
    "tenant:publish": "tsx scripts/tenant-publish.ts",
    "tenant:verify": "tsx scripts/tenant-verify.ts",
    "owner:invite": "tsx scripts/owner-invite.ts",
    "seed:build": "tsx scripts/build-seed.ts",
    "test:stack": "vitest run --project stack",
    "vapid:keys": "tsx scripts/vapid-keys.ts",
    "serve:dist": "tsx scripts/serve-dist.ts 4173",
    "local:reset": "tsx scripts/local/stack.ts start --reset"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.0",
    "@astryxdesign/theme-neutral": "0.7.0",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
