# Секреты Edge Functions. Файл создаётся командой `app.sh install` в
# /opt/supabase/app/functions.env (VAPID, CRON_SECRET и соль генерируются).
# После правки: sudo deploy/yandex/app.sh restart

PUBLIC_APP_URL=https://shop.example.ru
ALLOWED_ORIGINS=https://shop.example.ru
IP_HEADER=x-forwarded-for
IP_HASH_SALT=
CRON_SECRET=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ru

# YandexGPT через OpenAI-совместимый API (см. YANDEX-CLOUD.md, шаг 6).
# Пусто = помощник отвечает по данным магазина без модели.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TOOL_MODE=auto
LLM_JSON_RESPONSE_FORMAT=true
LLM_TENANT_DAILY_TOKENS=200000
LLM_GLOBAL_DAILY_TOKENS=2000000
